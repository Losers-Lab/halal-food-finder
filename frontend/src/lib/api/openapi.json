{
  "openapi": "3.1.0",
  "info": {
    "title": "Halal Food Finder API",
    "description": "HTTP API for Halal Food Finder. Contract lives at openapi/v1.json (OpenAPI 3.1). sc-133: the refresh token is delivered ONLY as an HttpOnly; Secure; SameSite=Lax cookie scoped to the auth routes and is never returned in JSON bodies; refresh/logout present the cookie (no request body).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/v1/auth/signup": {
      "post": {
        "tags": [
          "signup-controller"
        ],
        "summary": "Create an account",
        "description": "Validates the email/password, hashes the password with Argon2id, persists the account with the default role, and returns the created account.",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "409": {
            "description": "Email already exists",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Password is too weak",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "201": {
            "description": "Account created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "refresh-controller"
        ],
        "summary": "Refresh the session",
        "description": "Rotates the refresh token presented as the HttpOnly cookie: revokes it and issues a fresh access token (JSON body) and new refresh cookie (Set-Cookie). No request body.",
        "operationId": "refresh",
        "responses": {
          "400": {
            "description": "Missing refresh cookie",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or already-used refresh cookie",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Rotated; fresh access token issued and new refresh cookie set",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "logout-controller"
        ],
        "summary": "Log out",
        "description": "Revokes the refresh token presented as the HttpOnly cookie and clears it (Set-Cookie with Max-Age=0). Idempotent: unknown or absent cookies still succeed. No request body.",
        "operationId": "logout",
        "responses": {
          "400": {
            "description": "Invalid input",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "204": {
            "description": "Session revoked and refresh cookie cleared"
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "login-controller"
        ],
        "summary": "Log in",
        "description": "Verifies the email/password against the stored Argon2id hash and returns a short-lived access JWT (JSON body) plus sets the refresh token as an HttpOnly cookie. The refresh token is never returned in the JSON body.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Invalid input",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password (generic, no user enumeration)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Authenticated; access token returned, refresh cookie set",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "health-controller"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "SignupRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignupResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "id",
          "role"
        ]
      },
      "AuthResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accountId",
          "expiresIn",
          "role",
          "tokenType"
        ]
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}