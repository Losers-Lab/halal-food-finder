{"openapi":"3.1.0","info":{"title":"Tahir's List API","description":"HTTP API for Tahir's List. Contract lives at openapi/v1.json (OpenAPI 3.1).","version":"v1"},"servers":[{"url":"http://localhost:18080","description":"Generated server url"}],"paths":{"/v1/verification-committee/reviews/{reviewId}/deny":{"post":{"tags":["verification-committee-controller"],"summary":"Deny a verification","description":"Denies the certification review, recording the reason; the listing stays unverified.","operationId":"deny","parameters":[{"name":"reviewId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DecideRequest"}}},"required":true},"responses":{"403":{"description":"Verification Committee role required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Review not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Review not pending","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"400":{"description":"A denial reason is required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}},"200":{"description":"Denied; reason recorded","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}}}}},"/v1/verification-committee/reviews/{reviewId}/approve":{"post":{"tags":["verification-committee-controller"],"summary":"Approve a verification","description":"Approves the certification review and promotes the listing to VERIFIED (the only path to a verified listing).","operationId":"approve","parameters":[{"name":"reviewId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DecideRequest"}}}},"responses":{"403":{"description":"Verification Committee role required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Review not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Review not pending","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Approved; listing promoted to VERIFIED","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}}}}},"/v1/listings":{"get":{"tags":["listing-read-controller"],"summary":"Browse restaurants","description":"Minimal unfiltered browse surface (sc-157). Each card exposes only a thumbnail-size hero. Full filtered search is a later story.","operationId":"browse","responses":{"200":{"description":"Browse cards","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BrowseCard"}}}}}}},"post":{"tags":["listing-controller"],"summary":"Add a restaurant listing","description":"Creates a new, always-unverified restaurant listing owned by the authenticated account. Does not geocode; the client supplies coordinates.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateListingRequest"}}},"required":true},"responses":{"404":{"description":"Owning account not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"201":{"description":"Listing created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ListingResponse"}}}},"400":{"description":"Invalid input","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ListingResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ListingResponse"}}}}}}},"/v1/listings/{listingId}/claim":{"post":{"tags":["verification-claim-controller"],"summary":"Owner-claim verification","description":"Submits ownership proof + a certification image for the listing; drives the listing through the verification state machine (SUBMITTED -> AI_REVIEW -> AI_SUGGESTED) and returns the created review.","operationId":"claim","parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"proof":{"type":"string"},"aiConsent":{"type":"string"},"certImage":{"type":"string","format":"binary"}},"required":["aiConsent","certImage","proof"]}}}},"responses":{"404":{"description":"Listing not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Only the listing owner may claim","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"503":{"description":"Verification provider unavailable; review held for retry","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"201":{"description":"Review created and driven to AI_SUGGESTED","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClaimResponse"}}}},"400":{"description":"Missing proof or certification image","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClaimResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClaimResponse"}}}}}}},"/v1/favorites/{listingId}":{"post":{"tags":["favorites-controller"],"summary":"Favourite a listing","description":"Records the authenticated user's favourite for a listing. Idempotent — favouriting the same listing twice is a no-op.","operationId":"favorite","parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"404":{"description":"Listing not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"204":{"description":"Favourited (no body)"},"401":{"description":"Authentication required"}}},"delete":{"tags":["favorites-controller"],"summary":"Unfavourite a listing","description":"Removes the authenticated user's favourite for a listing. Idempotent — unfavouriting a listing that is not favourited is a no-op.","operationId":"unfavorite","parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"404":{"description":"Listing not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"204":{"description":"Unfavourited (no body)"},"401":{"description":"Authentication required"}}}},"/v1/auth/signup":{"post":{"tags":["signup-controller"],"summary":"Create an account","description":"Validates the email/password, hashes the password with Argon2id, persists the account with the default role, and returns the created account.","operationId":"signup","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignupRequest"}}},"required":true},"responses":{"409":{"description":"Email already exists","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Password is too weak","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"201":{"description":"Account created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SignupResponse"}}}},"400":{"description":"Invalid input","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SignupResponse"}}}}}}},"/v1/auth/refresh":{"post":{"tags":["refresh-controller"],"summary":"Refresh the session","description":"Rotates the refresh token presented in the HttpOnly cookie: revokes it and issues a fresh access token in the body plus a new refresh cookie.","operationId":"refresh","parameters":[{"name":"refresh_token","in":"cookie","required":false,"schema":{"type":"string"}}],"responses":{"401":{"description":"Invalid, expired, or already-used refresh token","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Rotated; new access token + refresh cookie issued","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"400":{"description":"Missing refresh cookie","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/v1/auth/logout":{"post":{"tags":["logout-controller"],"summary":"Log out","description":"Revokes the refresh token presented in the HttpOnly cookie so it can no longer be used to obtain a fresh access token, and clears the cookie. Idempotent: always succeeds regardless of whether the token was ever valid.","operationId":"logout","parameters":[{"name":"refresh_token","in":"cookie","required":false,"schema":{"type":"string"}}],"responses":{"204":{"description":"Refresh token revoked; cookie cleared"}}}},"/v1/auth/login":{"post":{"tags":["login-controller"],"summary":"Log in","description":"Verifies the email/password against the stored Argon2id hash and returns a short-lived access token (RS256 JWT with the account's RBAC role) in the body; the rotating refresh token is set as an HttpOnly; Secure; SameSite=Lax cookie scoped to the auth routes and is never returned in JSON.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"401":{"description":"Invalid email or password (generic, no user enumeration)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Authenticated; token pair issued","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"400":{"description":"Invalid input","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/v1/verification-committee/reviews":{"get":{"tags":["verification-committee-controller"],"summary":"List pending verifications","description":"Verification Committee workqueue: every certification review awaiting a human decision (AI_SUGGESTED).","operationId":"listPending","responses":{"403":{"description":"Verification Committee role required","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Review not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Review not pending","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Pending reviews","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReviewResponse"}}}},"401":{"description":"Authentication required","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ReviewResponse"}}}}}}}},"/v1/me":{"get":{"tags":["me-controller"],"operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/v1/listings/{id}":{"get":{"tags":["listing-read-controller"],"summary":"Restaurant detail","description":"Full listing detail including the full-res hero image URL and, for a VERIFIED listing whose certification was approved, the certificate display facts (certifier / reviewedOn / expiresOn / certificateUrl) so the detail trust panel can render non-empty fields (sc-73 follow-up).","operationId":"detail","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"404":{"description":"Listing not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DetailResponse"}}}},"200":{"description":"Detail payload","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DetailResponse"}}}}}}},"/v1/listings/{id}/image":{"get":{"tags":["listing-read-controller"],"summary":"Serve an image variant","description":"Same-origin proxy returning only the requested variant's bytes (thumbnail_400/768/1280/1920 or full original).","operationId":"serve","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"variant","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"No stored image for this variant","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}},"400":{"description":"Unknown variant","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}},"200":{"description":"Image bytes","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}}}}},"/v1/listings/{id}/certificate":{"get":{"tags":["listing-read-controller"],"summary":"Serve the listing's certification image","description":"Same-origin proxy returning the most recently archived certification image bytes for a listing (the CertificatePanel's View certificate target). SECURITY: cert images are archived evidence; surfacing them on a public read endpoint is a deliberate posture change reviewed by Omar in the sc-73 read-surface PR.","operationId":"serveCertificate","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Certificate image bytes","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}},"404":{"description":"No certification image archived for this listing","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}}}}},"/v1/listings/search":{"get":{"tags":["listing-read-controller"],"summary":"Search restaurants by location","description":"Returns listings within `radius` (miles) of `center` (latitude,longitude), ordered by straight-line distance ascending. `handCutOnly` (true/false; absent = any) is an extra on/off filter that narrows to hand-cut listings only; `deliveryOnly` (true/false; absent = any) narrows to listings offering delivery (sc-184); `cuisine` (repeatable) with `cuisineLogic` AND or OR (default OR) narrows by multi-cuisine membership; `minPrice`/`maxPrice` bound the price range; `minRating` sets the minimum listing rating on the 0..5 scale. (sc-10 location, sc-42 hand-cut, sc-184 delivery, sc-43 price, sc-44 cuisine, sc-45 rating). Public — the core search UX.","operationId":"search","parameters":[{"name":"center","in":"query","required":false,"schema":{"type":"string"}},{"name":"radius","in":"query","required":false,"schema":{"type":"number","format":"double"}},{"name":"handCutOnly","in":"query","required":false,"schema":{"type":"string"}},{"name":"deliveryOnly","in":"query","required":false,"schema":{"type":"string"}},{"name":"cuisine","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"}}},{"name":"cuisineLogic","in":"query","required":false,"schema":{"type":"string"}},{"name":"minPrice","in":"query","required":false,"schema":{"type":"number","format":"double"}},{"name":"maxPrice","in":"query","required":false,"schema":{"type":"number","format":"double"}},{"name":"minRating","in":"query","required":false,"schema":{"type":"number","format":"double"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":50}}],"responses":{"200":{"description":"Search results (distance ascending)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SearchCard"}}}}},"400":{"description":"Malformed centre, radius, handCutOnly, deliveryOnly, cuisine, cuisineLogic, price, or rating","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SearchCard"}}}}}}}},"/v1/health":{"get":{"tags":["health-controller"],"operationId":"health","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}}}}},"/v1/favorites":{"get":{"tags":["favorites-controller"],"summary":"List the authenticated user's favourites","description":"Returns the authenticated user's favourited listings as browse-card objects identical to the /v1/listings read shape.","operationId":"list","responses":{"404":{"description":"Listing not found","content":{"*/*":{"schema":{"$ref":"#/c